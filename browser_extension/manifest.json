{
  "manifest_version": 3,
  "name": "다운로드 출처 기록",
  "version": "1.1.0",
  "description": "연결한 HTTPS 웹페이지에서 받은 파일의 출처와 페이지 제목을 이 PC에 기록합니다.",
  "key": "",
  "permissions": ["downloads", "storage", "nativeMessaging", "webRequest", "alarms", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "host_permissions": ["https://clc.chosun.ac.kr/*"],
  "content_scripts": [{
    "matches": ["https://clc.chosun.ac.kr/*"],
    "js": ["course.js"],
    "all_frames": true,
    "run_at": "document_start"
  }],
  "background": {"service_worker": "downloads.js"},
  "action": {"default_popup": "status.html", "default_title": "다운로드 출처 기록"}
}
